---
import Layout from "../../layouts/Layout.astro";
import ProjectArt from "../../components/ProjectArt.astro";
import SystemMap from "../../components/SystemMap.astro";
import { projects, url } from "../../data/site";
export function getStaticPaths() {
  return projects.map((project, index) => ({
    params: { slug: project.slug },
    props: { project, next: projects[(index + 1) % projects.length] },
  }));
}
const { project, next } = Astro.props;
---

<Layout title={`${project.name} — Tarun Abraham`} description={project.intro}>
  <div id="top" class="wrap">
    <section class="case-intro">
      <a class="back-link" href={url("#work")}>
        ← All selected work
      </a>
      <p class="eyebrow">
        {project.category} · {project.year}
      </p>
      <h1>{project.name}</h1>
      <div class="case-lead">
        <h2>{project.line}</h2>
        <p>{project.intro}</p>
      </div>
    </section>
    <div class="case-hero">
      <ProjectArt slug={project.slug} image={project.image} alt={project.alt} />
    </div>
    <div class="case-meta">
      <dl>
        <dt>My role</dt>
        <dd>{project.role}</dd>
      </dl>
      <dl>
        <dt>Built with</dt>
        <dd>{project.stack}</dd>
      </dl>
      <dl>
        <dt>Status</dt>
        <dd>{project.status}</dd>
      </dl>
    </div>
    <div class="case-body">
      <section class="editorial-row case-contribution">
        <div class="body-copy">
          <h2>My contribution</h2>
          <ul class="contribution-list">
            {project.built.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </div>
      </section>
      {project.sections.map((section, i) => (
        <section class="editorial-row">
          <p class="eyebrow">{section.label}</p>
          <div class="body-copy">
            <h2>{section.title}</h2>
            <p>{section.body}</p>
            {project.slug === "admunos" && section.label === "The system" && (
              <SystemMap />
            )}
            {i === project.sections.length - 1 && (
              <div class="case-links">
                {project.link && (
                  <a class="text-link" href={project.link}>
                    {project.linkLabel}
                  </a>
                )}
                {project.repo && (
                  <a class="text-link" href={project.repo}>
                    View source
                  </a>
                )}
              </div>
            )}
          </div>
        </section>
      ))}
    </div>
    <a class="next-project" href={url(`work/${next.slug}/`)}>
      <div>
        <p class="eyebrow">Next project</p>
        <h2>{next.name}</h2>
      </div>
    </a>
  </div>
</Layout>
