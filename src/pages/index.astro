---
import Layout from "../layouts/Layout.astro";
import ProjectArt from "../components/ProjectArt.astro";
import { projects, url, talk } from "../data/site";

const summaries: Record<string, string> = {
  tacticlens:
    "A football match studio with 2D and 3D replays, different audience perspectives, and explanations you can trace back to the match events.",
  admunos:
    "I needed to manage logistics for ADMUN 2.7, so I started connecting registration, payment checks, delegate IDs, attendance, and meals in one system.",
  epileducate:
    "My first Swift app: an interactive playground about epilepsy, brain activity, and seizure first aid.",
};
---

<Layout>
  <section id="top" class="hero wrap">
    <div class="hero-heading">
      <h1>Tarun Abraham</h1>
      <p class="hero-location">Year 13 student in Dubai</p>
    </div>
    <figure class="hero-photo">
      <img
        src={url("images/tarun-portrait-480.webp")}
        srcset={`${url("images/tarun-portrait-240.webp")} 240w, ${url("images/tarun-portrait-480.webp")} 480w, ${url("images/tarun-portrait-768.webp")} 768w`}
        sizes="(max-width: 360px) 84px, (max-width: 600px) 100px, (max-width: 760px) 120px, 190px"
        alt="Tarun smiling, wearing glasses and a brown sweater, with his arms crossed"
        width="480"
        height="640"
        fetchpriority="high"
      />
      <figcaption>Hello, I’m Tarun.</figcaption>
    </figure>
    <div class="hero-bio">
      <p>
        I build things to understand how they work, or to solve a problem in
        front of me. Recently, that’s meant a football match studio, a
        conference logistics system, and my first Swift app.
      </p>
      <p>I also speak, sing, and spend a fair amount of time in MUN rooms.</p>
      <div class="hero-links">
        <a
          href={url("files/tarun-abraham-resume.pdf")}
          download="Tarun-Abraham-Resume.pdf"
          data-resume-trigger
        >
          Resume
        </a>
        <a href={url("about/")}>More about me</a>
      </div>
    </div>
  </section>

  <section id="work" class="work-section wrap">
    <h2>Projects</h2>
    {projects.map((project) => (
      <article class="project">
        <a
          class="project-visual"
          href={url(`work/${project.slug}/`)}
          aria-label={`Read the ${project.name} case study`}
        >
          <ProjectArt
            slug={project.slug}
            image={project.image}
            alt={project.alt}
          />
        </a>
        <div class="project-copy">
          <h3>
            <a href={url(`work/${project.slug}/`)}>{project.name}</a>
          </h3>
          <p class="project-status">{project.status}</p>
          <p>{summaries[project.slug]}</p>
          <p class="project-built">
            <strong>My work:</strong> {project.contribution}
          </p>
          <div class="project-links">
            <a href={url(`work/${project.slug}/`)}>Read case study</a>
            {project.link && (
              <a href={project.link}>
                {project.slug === "tacticlens" ? "Try the demo" : "View source"}
              </a>
            )}
          </div>
        </div>
      </article>
    ))}
  </section>

  <section class="speaking-section wrap" id="speaking">
    <h2>Selected achievements</h2>
    <div class="talk-copy" id="tedx-talk">
      <h3>Between Creation and Becoming</h3>
      <p class="detail">TEDxAl Diyafah High School</p>
      <p>
        My talk on artificial intelligence and the responsibility that comes
        with building powerful systems.
      </p>
      <a class="text-link" href={talk}>
        Watch the talk
      </a>
    </div>
    <div class="leadership-list">
      <div>
        <h3>
          <a href={url("about/#brainstormers")}>
            Brainstormers / Peter Jones Tycoon
          </a>
        </h3>
        <p>
          I led Brainstormers in the Peter Jones Tycoon Business Enterprise
          Competition. We were recognized as the winning business across the UAE
          that year.
        </p>
      </div>
      <div>
        <h3>
          <a href={url("about/#wharton")}>
            Wharton Global High School Investment Competition
          </a>
        </h3>
        <p>
          I introduced the competition to my school, helped establish its first
          participating team, and led investment strategy and stock-selection
          planning against the competition brief.
        </p>
      </div>
      <div>
        <h3>
          <a href={url("about/#sustainovation")}>Sustainovation Challenge</a>
        </h3>
        <p>
          Participated in the challenge hosted by De Montfort University and
          placed third.
        </p>
      </div>
    </div>
  </section>

  <section class="personal-note wrap">
    <h2>Outside these projects</h2>
    <p>
      I’m a vocalist and guitarist, a MUN enthusiast, and a founding core member
      of my school’s Entrepreneurial Club. There’s{" "}
      <a href={url("about/")}>more about me here</a>.
    </p>
    <p>
      I also keep a <a href={url("lab/")}>Lab</a> for experiments in code,
      automation, and hardware. You can try the barcode generator there.
    </p>
  </section>
</Layout>
