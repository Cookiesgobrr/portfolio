---
import { url } from "../data/site";
interface Props {
  slug: string;
  image: string;
  alt: string;
}
const { slug, image, alt } = Astro.props;
---

<div class:list={["project-art", slug]}>
  <div class="screen-frame">
    <div class="screen-bar" aria-hidden="true">
      <i></i>
      <i></i>
      <i></i>
      <span>
        {slug === "tacticlens"
          ? "TacticLens Live / match studio"
          : "EpilEducate / first aid"}
      </span>
    </div>
    <img
      src={url(`images/${image}`)}
      alt={alt}
      loading="lazy"
      width={slug === "tacticlens" ? 1308 : 1366}
      height={slug === "tacticlens" ? 836 : 1024}
    />
  </div>
</div>
