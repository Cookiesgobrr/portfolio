---
import { url } from "../data/site";
interface Props {
  slug: string;
  image: string;
  alt: string;
}
const { slug, image, alt } = Astro.props;
const dimensions =
  slug === "tacticlens"
    ? { width: 1308, height: 836 }
    : slug === "admunos"
      ? { width: 1363, height: 936 }
      : { width: 1366, height: 1024 };
---

<figure class:list={["project-art", slug]}>
  <img
    src={url(`images/${image}`)}
    alt={alt}
    loading="lazy"
    width={dimensions.width}
    height={dimensions.height}
  />
  {slug === "admunos" && (
    <figcaption>Interface preview with fictional demo data.</figcaption>
  )}
</figure>
