---
import "@fontsource-variable/eb-garamond";
import "@fontsource-variable/eb-garamond/wght-italic.css";
import "../styles/global.css";
import "../styles/resume-printer.css";
import ResumePrinter from "../components/ResumePrinter.astro";
import { url, email, linkedin, github } from "../data/site";
interface Props {
  title?: string;
  description?: string;
}
const {
  title = "Tarun Abraham — Builder, speaker & curious person",
  description = "I get curious about systems, then build things to understand or improve them. Explore TacticLens Live, admunOS, and EpilEducate by Tarun Abraham, a Year 13 student in Dubai.",
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const active = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f3f0e8" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={url("favicon.svg")} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta
      property="og:image"
      content={new URL(url("images/social.jpg"), Astro.site)}
    />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip" href="#main">
      Skip to content
    </a>
    <header class="site-header wrap">
      <a class="wordmark" href={url()} aria-label="Tarun Abraham, home">
        Tarun Abraham
      </a>
      <nav aria-label="Main navigation">
        <a
          href={url("#work")}
          aria-current={active.includes("/work/") ? "page" : undefined}
        >
          Work
        </a>
        <a
          href={url("about/")}
          aria-current={active.includes("/about") ? "page" : undefined}
        >
          About
        </a>
        <a
          href={url("lab/")}
          aria-current={active.includes("/lab") ? "page" : undefined}
        >
          Lab
        </a>
        <a class="nav-contact" href={url("#contact")}>
          Contact
        </a>
      </nav>
    </header>
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <footer id="contact" class="site-footer">
      <div class="wrap">
        <h2>Get in touch</h2>
        <p>I’d love to hear from people working on interesting things.</p>
        <div class="footer-bottom">
          <a href={`mailto:${email}`}>{email}</a>
          <div>
            <a href={github}>GitHub</a>
            <a href={linkedin}>LinkedIn</a>
            <a
              href={url("files/tarun-abraham-resume.pdf")}
              download="Tarun-Abraham-Resume.pdf"
              data-resume-trigger
            >
              Resume
            </a>
          </div>
        </div>
        <div class="colophon mono">
          <span>Tarun Abraham © {new Date().getFullYear()}</span>
          <a href="#top">Back to top</a>
        </div>
      </div>
    </footer>
    <ResumePrinter />
  </body>
</html>
